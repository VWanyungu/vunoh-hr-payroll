# Database (required)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=vunoh_hr_payroll
# Testing will use a different local db
TEST_DB_NAME=

# Redis (Upstash REST) 
REDIS_URL=
REDIS_TOKEN=

# JWT secrets (required)
ACCESS_TOKEN_SECRET=changeme-access-secret
REFRESH_TOKEN_SECRET=changeme-refresh-secret
FORGOT_PASSWORD_TOKEN_SECRET=changeme-forgot-password-secret

# Token expiry (required).
TOKEN_EXPIRY=15m
TOKEN_EXPIRY_ABSOLUTE=7d
TOKEN_EXPIRY_SECONDS=900

# URLs (required)
FRONTEND_URL=http://localhost:5500
BACKEND_URL=http://localhost:3000

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:5500

# Mail (optional) — the app boots without these, but POST /v1/forgot-password
# will fail because no reset email can be sent. 
SENDGRID_USER=
SENDGRID_PASSWORD=
MAIL_FROM=

# Server (required)
PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# Rate limiting (optional, sensible defaults shown)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_MAX_REQUESTS=5
